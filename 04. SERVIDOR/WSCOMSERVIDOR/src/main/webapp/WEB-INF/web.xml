<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">
    <display-name>WSCOMSERVIDOR - Conversor de Unidades Monster</display-name>

    <!-- CORS: solo lo necesita el cliente web que corre en el navegador.
         Formatos: origen exacto, http://host:* (cualquier puerto) o * (todos). -->
    <filter>
        <filter-name>FiltroCors</filter-name>
        <filter-class>ec.edu.monster.seguridad.FiltroCors</filter-class>
        <init-param>
            <param-name>cors.origenes.permitidos</param-name>
            <param-value>http://localhost:*,http://127.0.0.1:*</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>FiltroCors</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Errores de protocolo: una operación inexistente o un mensaje mal formado hace que Payara
         conteste "java.lang.NullPointerException". Este filtro lo cambia por un Fault genérico.
         Las operaciones deben coincidir con los @WebMethod de WSConversorUnidades
         (lo verifica la prueba FiltroPeticionSoapTest). Va después de CORS. -->
    <filter>
        <filter-name>FiltroPeticionSoap</filter-name>
        <filter-class>ec.edu.monster.seguridad.FiltroPeticionSoap</filter-class>
        <init-param>
            <param-name>soap.espacio.nombres</param-name>
            <param-value>http://ws.monster.edu.ec/</param-value>
        </init-param>
        <init-param>
            <param-name>soap.operaciones</param-name>
            <param-value>autenticar,obtenerCategorias,obtenerUnidades,convertir</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>FiltroPeticionSoap</filter-name>
        <url-pattern>/WSConversorUnidades</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
